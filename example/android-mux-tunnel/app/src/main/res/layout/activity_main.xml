<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/toggle_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_start" />

        <Button
            android:id="@+id/battery_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_battery"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/section_server"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/cdn_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_address"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/cdn_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_port"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/tunnel_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_tunnels"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/section_handshake"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/handshake_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_handshake_host"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/handshake_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_handshake_path"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/ws_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ws_key"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/ws_accept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ws_accept"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/note_tcp_only"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>
</ScrollView>
